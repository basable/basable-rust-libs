load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "basable_pubsub",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "basable_pubsub",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/basable-core:basable_core",
        "//crates/basable-db:basable_db",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "basable_pubsub_test",
    crate = ":basable_pubsub",
    deps = all_crate_deps(normal_dev = True),
)

# The database-backed suite: two buses over one database (the port of
# pubsub_test.go), against the Postgres TEST_DATABASE_URL names.
rust_test(
    name = "pubsub_bus",
    srcs = ["tests/bus.rs"],
    crate_root = "tests/bus.rs",
    data = ["//crates/basable-testkit:fixture_migrations"],
    env_inherit = ["TEST_DATABASE_URL"],
    tags = ["requires-network"],
    deps = [
        ":basable_pubsub",
        "//crates/basable-core:basable_core",
        "//crates/basable-db:basable_db",
        "//crates/basable-testkit:basable_testkit",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
