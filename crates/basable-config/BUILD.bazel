load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "basable_config",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "basable_config",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/basable-core:basable_core",
        "//crates/basable-db:basable_db",
        "//crates/basable-publicid:basable_publicid",
    ] + all_crate_deps(normal = True),
)

# The crate's own #[cfg(test)] modules: the registry, the seed parser, the
# reference graph (the port of graph_test.go) — no database.
rust_test(
    name = "basable_config_test",
    crate = ":basable_config",
    deps = all_crate_deps(normal_dev = True),
)

# The database-backed suites: one target per file under tests/, against the
# Postgres TEST_DATABASE_URL names (skipped, loudly, without it), over the
# tenant fixture migrations and the seed directories under tests/seed/.
[
    rust_test(
        name = "config_" + src[len("tests/"):-len(".rs")],
        srcs = [src],
        crate_root = src,
        data = ["//crates/basable-testkit:fixture_migrations"] + glob(["tests/seed/**"]),
        env_inherit = ["TEST_DATABASE_URL"],
        tags = ["requires-network"],
        deps = [
            ":basable_config",
            "//crates/basable-core:basable_core",
            "//crates/basable-db:basable_db",
            "//crates/basable-publicid:basable_publicid",
            "//crates/basable-testkit:basable_testkit",
        ] + all_crate_deps(
            normal = True,
            normal_dev = True,
        ),
    )
    for src in glob(["tests/*.rs"])
]
