load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "basable_connect",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "basable_connect",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/basable-auth:basable_auth",
        "//crates/basable-core:basable_core",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "basable_connect_test",
    crate = ":basable_connect",
    deps = all_crate_deps(normal_dev = True),
)
