load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "basable_app",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "basable_app",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/basable-core:basable_core",
        "//crates/basable-db:basable_db",
        "//crates/basable-processingobject:basable_processingobject",
        "//crates/basable-pubsub:basable_pubsub",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "basable_app_test",
    crate = ":basable_app",
    deps = all_crate_deps(normal_dev = True),
)

# The database-backed suites: the boot sequence and the ledger gate, pool
# isolation, the wake bus, readiness over a live server, and the SIGTERM
# drain of an in-flight attempt; against the Postgres TEST_DATABASE_URL
# names, over the tenant fixture migrations and the conformance type.
[
    rust_test(
        name = "app_" + src[len("tests/"):-len(".rs")],
        srcs = [src],
        crate_root = src,
        data = ["//crates/basable-testkit:fixture_migrations"],
        env_inherit = ["TEST_DATABASE_URL"],
        tags = ["requires-network"],
        deps = [
            ":basable_app",
            "//crates/basable-core:basable_core",
            "//crates/basable-db:basable_db",
            "//crates/basable-processingobject:basable_processingobject",
            "//crates/basable-processingobject-testkit:basable_processingobject_testkit",
            "//crates/basable-pubsub:basable_pubsub",
            "//crates/basable-testkit:basable_testkit",
        ] + all_crate_deps(
            normal = True,
            normal_dev = True,
        ),
    )
    for src in glob(["tests/*.rs"])
]
