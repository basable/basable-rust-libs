load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "basable_ledger",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "basable_ledger",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/basable-core:basable_core",
    ] + all_crate_deps(normal = True),
)

# The crate's own #[cfg(test)] modules: the merge patch, the recorder, the
# engine over the in-memory store. The scenario and property suites and the
# store conformance suite live in basable-ledger-testkit.
rust_test(
    name = "basable_ledger_test",
    crate = ":basable_ledger",
    deps = all_crate_deps(normal_dev = True),
)
