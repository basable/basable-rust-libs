load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "basable_db",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "basable_db",
    visibility = ["//visibility:public"],
    deps = ["//crates/basable-core:basable_core"] + all_crate_deps(normal = True),
)

# The crate's own #[cfg(test)] modules: parsing and pure helpers. Everything
# that needs a database lives in basable-testkit's tests, which depend on
# this crate (never the reverse).
rust_test(
    name = "basable_db_test",
    crate = ":basable_db",
    deps = all_crate_deps(normal_dev = True),
)
