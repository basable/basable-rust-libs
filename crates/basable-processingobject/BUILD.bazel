load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "basable_processingobject",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "basable_processingobject",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/basable-core:basable_core",
        "//crates/basable-db:basable_db",
        "//crates/basable-publicid:basable_publicid",
    ] + all_crate_deps(normal = True),
)

# The crate's own #[cfg(test)] modules: the pure half (outcome, declaration,
# backoff, the read model's helpers). Everything against a database lives
# in basable-processingobject-testkit's suites, which depend on this crate.
rust_test(
    name = "basable_processingobject_test",
    crate = ":basable_processingobject",
    compile_data = ["tests/fixtures/backoff_go.txt"],
    deps = all_crate_deps(normal_dev = True),
)
