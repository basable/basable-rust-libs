# The binary and its image. rust_server() (k8s/infra/rust_server.bzl) builds
# the x86_64 Linux binary, packages it on the distroless cc base as user
# 65532, and mints the push targets `//:push` runs.
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("//k8s/infra:rust_server.bzl", "rust_server")

# The dbmate versions this binary embeds, from the migration file names:
# boot refuses to serve until the ledger holds every one of them.
genrule(
    name = "migration_versions",
    srcs = ["//db/app:migrations"],
    outs = ["src/migrations.rs"],
    cmd = "\n".join([
        "echo '// GENERATED by app/BUILD.bazel from db/app/migrations. DO NOT EDIT.' > $@",
        "echo 'pub const MIGRATIONS: &[&str] = &[' >> $@",
        "for f in $(SRCS); do b=$$(basename $$f .sql); echo \"    \\\"$${b%%_*}\\\",\" >> $@; done",
        "echo '];' >> $@",
    ]),
)

rust_server(
    name = "app",
    srcs = glob(["src/**/*.rs"]) + [":migration_versions"],
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/messages",
        "//crates/interfaces",
        "//crates/messenger",
        "//api",
        # basable:bazel-deps-begin
        "//nanoservices/catalog",
        "//nanoservices/order",
        "//nanoservices/notifier",
        # basable:bazel-deps-end
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    repositories = ["registry.test.local/abandon-above-tilt/shop"],
    visibility = ["//visibility:public"],
)
